#!/bin/sh
# Local pre-commit gate. CI is a mirror of this, never a replacement.
# Activate once per clone:  git config core.hooksPath .githooks
#
# Order is cheapest-first so a trivial slip fails fast. Every step blocks.
#   1. secrets  - staged added lines against credential shapes (scripts/check-secrets.mjs)
#   2. format   - prettier on the staged files (the tree-wide check is `npm run format:check`)
#   3. lint     - eslint incl. security rules; errors block, warnings are reviewed per site
#   4. motion   - transform/class constraint on every scene (scripts/check-motion.tsx)
#   5. test     - vitest with coverage thresholds (vitest.config.ts)
#   6. build    - `tsc -b` typecheck then the production bundle
#   7. bundle   - JS gzip and precache totals against budgets (scripts/check-bundle.mjs)
set -e

echo "pre-commit: secret scan"
npm run --silent secrets

echo "pre-commit: format (staged files)"
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ]; then
  echo "$staged" | xargs npx prettier --check --ignore-unknown
fi

echo "pre-commit: lint"
npm run --silent lint

echo "pre-commit: motion constraints"
npm run --silent check:motion

echo "pre-commit: tests + coverage thresholds"
npm run --silent coverage

echo "pre-commit: typecheck + build"
npm run --silent build

echo "pre-commit: bundle budgets"
npm run --silent check:bundle
