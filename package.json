{
  "name": "bible-adventures",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive, illustrated Bible storybook app for kids.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/generate-icons.mjs",
    "check:motion": "esbuild scripts/check-motion.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --loader:.webp=dataurl --outfile=scratch/check-motion.mjs --log-level=warning && node scratch/check-motion.mjs",
    "compare": "esbuild scripts/compare.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --loader:.webp=dataurl --outfile=scratch/compare.mjs --log-level=warning && node scratch/compare.mjs",
    "covers": "esbuild scripts/covers.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --loader:.webp=dataurl --outfile=scratch/covers.mjs --log-level=warning && node scratch/covers.mjs",
    "render": "esbuild scripts/render-scenes.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --loader:.webp=dataurl --outfile=scratch/render.mjs --log-level=warning && node scratch/render.mjs",
    "lint": "eslint .",
    "format": "prettier --write src scripts \"*.{js,mjs,ts}\"",
    "format:check": "prettier --check src scripts \"*.{js,mjs,ts}\"",
    "test": "vitest run",
    "secrets": "node scripts/check-secrets.mjs",
    "audit": "npm audit --audit-level=high",
    "coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
