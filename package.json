{
  "name": "bible-adventures",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive, illustrated Bible storybook app for kids.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/generate-icons.mjs",
    "check:motion": "esbuild scripts/check-motion.tsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=scratch/check-motion.mjs --log-level=warning && node scratch/check-motion.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
